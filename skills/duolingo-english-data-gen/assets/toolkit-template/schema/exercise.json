{
  "_doc": "Union schema for all 13 teaching exercise types. Universal fields are checked here; type-specific and nested teaching contracts are enforced by DL-Type and DL-Content in validate.py.",
  "required": ["id", "exercise_type", "interaction_mode", "stage", "bloom", "cefr", "needs_speaking", "needs_listening", "prompt"],
  "properties": {
    "id": {"type": "string"},
    "exercise_type": {"type": "string", "enum": ["tap_pairs", "picture_flashcard", "mark_meaning", "select_missing_word", "read_and_respond", "arrange_words", "sentence_shuffle", "complete_translation", "translate", "type_what_you_hear", "what_do_you_hear", "speak_this_sentence", "character_dialogue"]},
    "interaction_mode": {"type": "string", "enum": ["single_choice", "pair_match", "word_bank", "text_input", "listening_input", "listening_choice", "speaking", "dialogue_choice"]},
    "stage": {"type": "string", "enum": ["recognition", "understanding", "constrained_production", "free_production", "end_on_easy"]},
    "bloom": {"type": "string", "enum": ["remember", "understand", "apply"]},
    "cefr": {"type": "string", "enum": ["A1", "A2", "B1", "B2"]},
    "needs_speaking": {"type": "boolean"},
    "needs_listening": {"type": "boolean"},
    "prompt": {"type": "string"},
    "audio_ref": {"type": "string"},
    "slow_audio_ref": {"type": "string"},
    "hint_zh": {"type": "string"},
    "meaning_zh": {"type": "string"},
    "explanation_zh": {"type": "string"},
    "common_error_zh": {"type": "string"},
    "image_ref": {"type": "string"},
    "image_prompt": {"type": "string"},

    "options": {"type": "array"},
    "answer": {"_doc": "Type-specific: string option id/text for choice/input exercises; pair array for tap_pairs. DL-Type validates shape."},
    "distractors": {"type": "array"},

    "tokens": {"type": "array"},
    "answer_tokens": {"type": "array"},
    "target_sentence": {"type": "string"},

    "source_text": {"type": "string"},
    "direction": {"type": "string", "enum": ["en2zh", "zh2en", "en2en"]},
    "accepted_variants": {"type": "array"},
    "normalization": {"type": "object"},

    "scoring_rubric": {"type": "object"},

    "turns": {"type": "array"},
    "question": {"type": "string"}
  }
}
