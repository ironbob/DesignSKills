{
  "_doc": "示例配置。复制为 config.json 后按课程改。CEFR 取代年级；单文件原子课；curve_defaults 各 CEFR 一套默认曲线（outline 课节点可省略 curve_plan 继承之）。",
  "product": {"name": "多邻国式英语课（示例）", "subject": "en", "default_cefr": "A1"},
  "llm": {
    "provider": "claude_code",
    "generate_model": "sonnet",
    "temperature": 0.7,
    "max_tokens": 4096,
    "max_tokens_by_level": {"A1": 4096, "A2": 4096, "B1": 6144, "B2": 8192},
    "max_retries": 3,
    "timeout": 180
  },
  "paths": {
    "outline_dir": "outline",
    "content_list": "content_list",
    "schemas_dir": "schema",
    "prompts_dir": "prompts",
    "output_dir": "output",
    "state_file": "state/state.json",
    "cast_file": "cast.json"
  },
  "curve_defaults": {
    "A1": {"total": 15, "stages": [
      {"stage": "recognition", "count": 6, "bloom": "remember", "allowed_types": ["picture_flashcard", "tap_pairs", "mark_meaning"]},
      {"stage": "understanding", "count": 4, "bloom": "understand", "allowed_types": ["select_missing_word", "read_and_respond", "mark_meaning", "character_dialogue"]},
      {"stage": "constrained_production", "count": 3, "bloom": "apply", "allowed_types": ["arrange_words", "sentence_shuffle", "complete_translation"]},
      {"stage": "free_production", "count": 1, "bloom": "apply", "allowed_types": ["translate", "type_what_you_hear", "speak_this_sentence"]},
      {"stage": "end_on_easy", "count": 1, "bloom": "remember", "allowed_types": ["picture_flashcard", "tap_pairs"]}
    ]},
    "A2": {"total": 15, "stages": [
      {"stage": "recognition", "count": 5, "bloom": "remember", "allowed_types": ["picture_flashcard", "tap_pairs", "mark_meaning"]},
      {"stage": "understanding", "count": 4, "bloom": "understand", "allowed_types": ["select_missing_word", "read_and_respond", "mark_meaning", "character_dialogue"]},
      {"stage": "constrained_production", "count": 3, "bloom": "apply", "allowed_types": ["arrange_words", "sentence_shuffle", "complete_translation"]},
      {"stage": "free_production", "count": 2, "bloom": "apply", "allowed_types": ["translate", "type_what_you_hear", "speak_this_sentence"]},
      {"stage": "end_on_easy", "count": 1, "bloom": "remember", "allowed_types": ["picture_flashcard", "tap_pairs"]}
    ]},
    "B1": {"total": 15, "stages": [
      {"stage": "recognition", "count": 3, "bloom": "remember", "allowed_types": ["picture_flashcard", "tap_pairs", "mark_meaning"]},
      {"stage": "understanding", "count": 4, "bloom": "understand", "allowed_types": ["select_missing_word", "read_and_respond", "mark_meaning"]},
      {"stage": "constrained_production", "count": 4, "bloom": "apply", "allowed_types": ["arrange_words", "sentence_shuffle", "complete_translation"]},
      {"stage": "free_production", "count": 3, "bloom": "apply", "allowed_types": ["translate", "type_what_you_hear", "speak_this_sentence", "character_dialogue"]},
      {"stage": "end_on_easy", "count": 1, "bloom": "remember", "allowed_types": ["picture_flashcard", "tap_pairs"]}
    ]},
    "B2": {"total": 15, "stages": [
      {"stage": "recognition", "count": 2, "bloom": "remember", "allowed_types": ["picture_flashcard", "tap_pairs", "mark_meaning"]},
      {"stage": "understanding", "count": 3, "bloom": "understand", "allowed_types": ["select_missing_word", "read_and_respond", "mark_meaning"]},
      {"stage": "constrained_production", "count": 4, "bloom": "apply", "allowed_types": ["arrange_words", "sentence_shuffle", "complete_translation"]},
      {"stage": "free_production", "count": 5, "bloom": "apply", "allowed_types": ["translate", "type_what_you_hear", "speak_this_sentence", "character_dialogue"]},
      {"stage": "end_on_easy", "count": 1, "bloom": "remember", "allowed_types": ["picture_flashcard", "tap_pairs"]}
    ]}
  },
  "file_split": {"mode": "single_file", "_doc": "一节课 = 一个文件（含全部 exercises + meta）。单文件原子课。"},
  "coverage_threshold": 1.0,
  "dl_audio_strict": false,
  "gates": {
    "G1_schema": true, "G2_coverage": true, "G5_accuracy": true,
    "G6_age": true, "G7_diversity": true, "G8_traceability": true,
    "DL_Type": true, "DL_Content": true, "DL_Curve": true, "DL_Distractors": true,
    "DL_Translation": true, "DL_Lock": true, "DL_Cast": true, "DL_Audio": true
  },
  "tts": {
    "_doc": "音频生成配置。provider 走 tts_providers.py 工厂（edge/iflytek/tencent/glm）；换 provider 改这里 + 对应环境变量。generate_audio.py 读此块，CLI 可覆盖。",
    "provider": "edge",
    "default_voice": "en-US-AriaNeural",
    "voice_a": "en-US-AriaNeural",
    "voice_b": "en-US-GuyNeural",
    "rate": "-5%",
    "slow_rate": "-30%",
    "concurrency": 8,
    "max_retries": 3
  },
  "sample": {"size": 3, "seed": 0}
}
